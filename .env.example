# Bharath Aadhya Intelligence: environment variables for the Project Inquiry form.
#
# This file contains placeholders only. Never put real keys in it.
# Full setup steps: docs/CONTACT_FORM.md
#
# Where each variable is set:
#   NEXT_PUBLIC_CONTACT_API_URL  -> GitHub repo Variables (Settings > Secrets and variables > Actions > Variables)
#                                   and optionally .env.local for local `next build`/`next dev`.
#   RESEND_API_KEY, CONTACT_TO_EMAIL, CONTACT_FROM_EMAIL, ALLOWED_ORIGINS
#                                -> Vercel project (Settings > Environment Variables). Never GitHub, never the site build.

# ---- Public: used by the static site at build time (NOT a secret) ----
# Full URL of the deployed inquiry API.
NEXT_PUBLIC_CONTACT_API_URL=https://your-api-project.vercel.app/api/contact

# ---- Server-only: set in Vercel, never in the browser build ----
# Resend API key (https://resend.com/api-keys). SECRET.
RESEND_API_KEY=re_your_actual_api_key

# Where inquiry notifications are delivered.
CONTACT_TO_EMAIL=bharathaadhyaintelligence@gmail.com

# Sender address on a domain verified in Resend (https://resend.com/domains).
CONTACT_FROM_EMAIL=notifications@your-verified-domain.com

# Website origin(s) allowed to call the API. Exact scheme + host, no path.
# Comma-separate several origins. Use http://localhost:3000 only in a Preview environment for local testing.
ALLOWED_ORIGINS=https://bharath-aadhya-intelligence.github.io
